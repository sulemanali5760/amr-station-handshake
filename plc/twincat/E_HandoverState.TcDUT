<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_HandoverState" Id="{6c1f0b52-3a7e-4f0d-9d61-2b8e5a4c7d10}">
    <Declaration><![CDATA[// State of FB_StationHandshake (docs/SPEC.md, "Sequence").
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_HandoverState :
(
    eIdle         := 0,   // no request: all outputs off (R1)
    eReady        := 1,   // request seen, station free: StationReady on (R2), nothing moves (R3)
    eTransferring := 2,   // vehicle in position: conveyor runs, TransferActive on (R4)
    eDone         := 3,   // load arrived: TransferDone on, TransferActive off (R4)
    eFault        := 4    // Fault + FaultCode latched until the request drops (R8, R9, R10)
) INT;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
