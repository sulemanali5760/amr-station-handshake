# Goal: the robot is at the station and wants to hand over its load.
string amr_id
---
# Result
bool success
# Phase the handshake ended in: succeeded, timed_out, faulted, canceled or link_error.
string phase
# Empty on success, otherwise a human-readable reason.
string error
---
# Feedback: sent every time the handshake enters a new phase.
string phase
